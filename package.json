{
    "name": "toricontroller",
    "productName": "ToriController",
    "description": "ToriController - Advanced ROV and Submarine Ground Control Station",
    "author": {
        "name": "Sajid Sam",
        "url": "https://github.com/sajidsam"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sajidsam/ToriController-2.0.git"
    },
    "homepage": "https://github.com/sajidsam/ToriController-2.0",
    "private": true,
    "version": "2.0.10",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "electron": "electron .",
        "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "vite build",
        "dist": "npm run build && electron-builder",
        "dist:win": "npm run build && electron-builder --win --x64",
        "dist:portable": "npm run build && electron-builder --win portable --x64",
        "dist:mac": "npm run build && electron-builder --mac",
        "preview": "vite preview",
        "lint": "eslint ."
    },
    "dependencies": {
        "@capacitor/core": "^8.4.1",
        "@capacitor/ios": "^8.4.1",
        "@serialport/parser-readline": "^13.0.0",
        "leaflet": "^1.9.4",
        "node-wifi": "^2.0.16",
        "react-leaflet": "^5.0.0",
        "serialport": "^13.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.4.1",
        "@eslint/js": "^9.39.4",
        "@tailwindcss/vite": "^4.2.2",
        "@tensorflow-models/coco-ssd": "^2.2.3",
        "@tensorflow/tfjs": "^4.22.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "canvas": "^3.2.3",
        "concurrently": "^9.2.1",
        "electron": "^41.2.0",
        "electron-builder": "^26.8.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "lucide-react": "^1.25.0",
        "onnxruntime-node": "^1.27.0",
        "onnxruntime-web": "^1.27.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-icons": "^5.7.0",
        "recharts": "^3.10.0",
        "tailwindcss": "^4.2.2",
        "three": "^0.185.1",
        "vite": "^8.0.4",
        "wait-on": "^9.0.5"
    },
    "build": {
        "appId": "com.toricontroller.app",
        "productName": "ToriController",
        "copyright": "Copyright © 2026 Sajid Sam",
        "compression": "maximum",
        "asar": true,
        "npmRebuild": false,
        "asarUnpack": [
            "**/node_modules/@serialport/bindings-cpp/**",
            "**/node_modules/serialport/**",
            "**/node_modules/node-wifi/**"
        ],
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json",
            "!**/*.map",
            "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!**/node_modules/*.d.ts",
            "!**/node_modules/.bin"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "electron/assets/hero.ico",
            "requestedExecutionLevel": "asInvoker"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "ToriController",
            "uninstallDisplayName": "ToriController",
            "installerIcon": "electron/assets/hero.ico",
            "uninstallerIcon": "electron/assets/hero.ico",
            "installerHeaderIcon": "electron/assets/hero.ico",
            "deleteAppDataOnUninstall": false,
            "artifactName": "${productName}-Setup-${version}.${ext}"
        },
        "portable": {
            "artifactName": "${productName}-Portable-${version}.${ext}"
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "icon": "electron/assets/hero_512.png",
            "category": "public.app-category.utilities",
            "artifactName": "${productName}-${version}-Mac.${ext}"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "icon": "electron/assets/hero_512.png",
            "category": "Utility",
            "artifactName": "${productName}-${version}-Linux.${ext}"
        },
        "publish": {
            "provider": "github",
            "owner": "sajidsam",
            "repo": "ToriController-2.0"
        }
    }
}
